<table>
<thead><tr><th>Campo</th><th>Medida</th><th class="num">Bronze</th><th class="num">Silver</th></tr></thead>
<tbody>
<tr><td><code>endereco.cidade</code></td><td>valores em grafia múltipla</td>
    <td class="num">{{ dados.texto.cidade.bronze }}</td><td class="num">{{ dados.texto.cidade.silver }}</td></tr>
<tr><td><code>endereco.nome_local</code></td><td>valores em grafia múltipla</td>
