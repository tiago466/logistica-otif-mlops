# === Modelo de configuração (12-factor) ===
# Copie para `.env` e preencha com os valores reais. O `.env` NUNCA vai ao git.
#
#   cp .env.example .env
#
# Cada conector de dados novo (connectors/registry.py) acrescenta suas
# variáveis aqui, sem valores.

# Ambiente de execução: dev | hmlg | prod
AMBIENTE=dev

# --- Banco relacional da TransBrasil (schemas operacao + custos) ---
# dev: Postgres local do docker-compose (valores abaixo casam com os defaults dele)
# hmlg: cole aqui a connection string do Neon
DATABASE_URL=postgresql+psycopg://transbrasil:transbrasil@localhost:5432/transbrasil

# Credenciais do container local (docker-compose lê deste arquivo se copiado p/ .env)
POSTGRES_USER=transbrasil
POSTGRES_PASSWORD=transbrasil
POSTGRES_DB=transbrasil

# --- API de custos (o sistema financeiro terceiro) ---
# Chave que a API exige no cabecalho X-API-Key. Gere uma com:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
CUSTOS_API_KEY=troque-por-uma-chave-forte
# Banco que a API le. Em producao, aponte para o Neon (usuario SOMENTE LEITURA).
# CUSTOS_API_DATABASE_URL=postgresql+psycopg://usuario:senha@host/base?sslmode=require
# Endereco da API para o conector cliente consumir
CUSTOS_API_URL=http://localhost:8100

# --- Publicacao em nuvem (Neon) ---
# Destino do recorte publicado por seed/publicar_neon.py. So o script usa.
# NEON_DATABASE_URL=postgresql+psycopg://usuario:senha@host/base?sslmode=require
